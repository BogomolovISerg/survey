// Добавить в модуль формы элемента справочника бигМероприятия (Catalogs/бигМероприятия/Forms/ФормаЭлемента/Module.bsl).
// Кнопки формы: ОпубликоватьВСервисе, ЗагрузитьРезультаты, ОткрытьАнкету — обработчики ниже.

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОпубликоватьВСервисе(Команда)
	
	Если Модифицированность Или НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Если НЕ Записать() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Результат = ОпубликоватьНаСервере(Объект.Ссылка);
	Прочитать();
	Если Результат.Успех Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Опубликовано'"), , Результат.Сообщение, БиблиотекаКартинок.Информация32);
	Иначе
		ПоказатьПредупреждение(, Результат.Сообщение, , НСтр("ru = 'Публикация в сервисе анкетирования'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьРезультаты(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала запишите и опубликуйте мероприятие.'"));
		Возврат;
	КонецЕсли;
	Результат = ЗагрузитьРезультатыНаСервере(Объект.Ссылка);
	Прочитать();
	Если Результат.Успех Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Результаты анкетирования'"), , Результат.Сообщение, БиблиотекаКартинок.Информация32);
	Иначе
		ПоказатьПредупреждение(, Результат.Сообщение, , НСтр("ru = 'Загрузка результатов'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьАнкету(Команда)
	
	Если ЗначениеЗаполнено(Объект.ПубличнаяСсылка) Тогда
		ПерейтиПоНавигационнойСсылке(Объект.ПубличнаяСсылка);
	Иначе
		ПоказатьПредупреждение(, НСтр("ru = 'Мероприятие ещё не опубликовано.'"));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ОпубликоватьНаСервере(Мероприятие)
	Возврат бигАнкетированиеОбменСервер.ОпубликоватьМероприятие(Мероприятие);
КонецФункции

&НаСервереБезКонтекста
Функция ЗагрузитьРезультатыНаСервере(Мероприятие)
	Возврат бигАнкетированиеОбменСервер.ЗагрузитьРезультаты(Мероприятие);
КонецФункции

#КонецОбласти
