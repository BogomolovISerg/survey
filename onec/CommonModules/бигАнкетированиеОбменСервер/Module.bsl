// Анкетирование v2 (БИГ): обмен с веб-сервисом survey. 1С — инициатор.
//
//   ОпубликоватьМероприятие(Мероприятие)  — PUT  /api/v1/sync/events/{guid}: мероприятие + JSON-схема анкеты (СформироватьJSON);
//   ЗагрузитьРезультаты(Мероприятие)      — GET  /api/v1/sync/events/{guid}/responses?after=КурсорВыгрузки → запись в РС бигДанныеАнкет
//                                            → POST …/responses/ack. Курсор двигается только после успешной записи пачки.
//   ПолучитьСтатус(Мероприятие)           — GET  /api/v1/sync/events/{guid}/status.
//   ЗагрузитьРезультатыВсехМероприятий()  — для регламентного задания.
//
// Настройки — безопасное хранилище, владелец "survey": Структура (url, login, password).
// Задать: бигАнкетированиеОбменСервер.УстановитьНастройкиОбмена("https://survey.bigcom.ru/survey", "erp", "пароль").
//
// Совместимость с v1: в РС бигДанныеАнкет пишутся Дата = submittedAt (стабильна при повторной загрузке),
// Идентификатор = id ответа сервиса (36 символов), Данные = структура ответов как в v1, ДанныеJSON, БонусПредоставлен.

#Область ПрограммныйИнтерфейс

// Публикует мероприятие и текущую анкету в сервис. Обновляет реквизиты Опубликовано, ВерсияПубликации, ПубличнаяСсылка.
//
// Параметры:
//   Мероприятие - СправочникСсылка.бигМероприятия
//
// Возвращаемое значение:
//   Структура:
//     * Успех - Булево - публикация выполнена.
//     * Сообщение - Строка - текст для пользователя.
//     * Версия - Число - версия анкеты в сервисе.
//     * Ссылка - Строка - публичная ссылка анкеты (для QR).
//     * Изменена - Булево - создана новая версия анкеты.
//
Функция ОпубликоватьМероприятие(Мероприятие) Экспорт

	Результат = Новый Структура("Успех, Сообщение, Версия, Ссылка, Изменена", Ложь, "", 0, "", Ложь);

	Если НЕ ЗначениеЗаполнено(Мероприятие) Тогда
		Результат.Сообщение = НСтр("ru = 'Мероприятие не записано.'");
		Возврат Результат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Мероприятие.Анкета) Тогда
		Результат.Сообщение = НСтр("ru = 'У мероприятия не выбрана анкета.'");
		Возврат Результат;
	КонецЕсли;

	Попытка
		СхемаСтрокой = Справочники.бигКомпонентыАнкеты.СформироватьJSON(Мероприятие.Анкета);
	Исключение
		ЗаписатьОшибку(Мероприятие, НСтр("ru = 'Не удалось сформировать JSON анкеты'"), ИнформацияОбОшибке());
		Результат.Сообщение = НСтр("ru = 'Не удалось сформировать JSON анкеты. См. журнал регистрации.'");
		Возврат Результат;
	КонецПопытки;

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СхемаСтрокой);
	Схема = ПрочитатьJSON(ЧтениеJSON, Истина);

	Тело = Новый Структура;
	Тело.Вставить("name",         Строка(Мероприятие.Наименование));
	Тело.Вставить("startsOn",     ДатаВСтрокуISO(Мероприятие.ДатаНачала));
	Тело.Вставить("endsOn",       ДатаВСтрокуISO(Мероприятие.ДатаОкончания));
	Тело.Вставить("giftEnabled",  Мероприятие.Подарок = Истина);
	Тело.Вставить("active",       Истина);
	Тело.Вставить("questionnaire", Схема);

	Ответ = ВыполнитьЗапрос("PUT", "/api/v1/sync/events/" + ИдентификаторМероприятия(Мероприятие), Тело);
	Если НЕ Ответ.Успех Тогда
		ЗаписатьОшибку(Мероприятие, НСтр("ru = 'Публикация отклонена сервисом'"), Ответ.Сообщение);
		Результат.Сообщение = Ответ.Сообщение;
		Возврат Результат;
	КонецЕсли;

	Данные = Ответ.Данные;
	Результат.Успех    = Истина;
	Результат.Версия   = Данные.version;
	Результат.Ссылка   = Данные.publicUrl;
	Результат.Изменена = Данные.changed = Истина;
	Результат.Сообщение = ?(Результат.Изменена,
		СтрШаблон(НСтр("ru = 'Опубликована версия анкеты %1.'"), Результат.Версия),
		СтрШаблон(НСтр("ru = 'Анкета не изменилась, действует версия %1.'"), Результат.Версия));

	ОбновитьРеквизитыМероприятия(Мероприятие, Новый Структура("Опубликовано, ВерсияПубликации, ПубличнаяСсылка",
		ТекущаяДатаСеанса(), Результат.Версия, Результат.Ссылка));

	Возврат Результат;

КонецФункции

// Загружает новые/изменённые ответы мероприятия в РС бигДанныеАнкет и подтверждает курсор сервису.
//
// Параметры:
//   Мероприятие - СправочникСсылка.бигМероприятия
//
// Возвращаемое значение:
//   Структура:
//     * Успех - Булево - загрузка выполнена без ошибок.
//     * Сообщение - Строка - текст для пользователя.
//     * Загружено - Число - сколько ответов записано/обновлено.
//     * Курсор - Число - подтверждённый курсор выгрузки.
//
Функция ЗагрузитьРезультаты(Мероприятие) Экспорт

	Результат = Новый Структура("Успех, Сообщение, Загружено, Курсор", Ложь, "", 0, 0);

	Если НЕ ЗначениеЗаполнено(Мероприятие) Тогда
		Результат.Сообщение = НСтр("ru = 'Мероприятие не записано.'");
		Возврат Результат;
	КонецЕсли;

	Курсор = Мероприятие.КурсорВыгрузки;
	Идентификатор = ИдентификаторМероприятия(Мероприятие);
	ВсегоЗагружено = 0;

	Пока Истина Цикл
		Ответ = ВыполнитьЗапрос("GET", "/api/v1/sync/events/" + Идентификатор + "/responses?after=" + Формат(Курсор, "ЧГ=0") + "&limit=200");
		Если НЕ Ответ.Успех Тогда
			ЗаписатьОшибку(Мероприятие, НСтр("ru = 'Не удалось получить ответы из сервиса'"), Ответ.Сообщение);
			Результат.Сообщение = Ответ.Сообщение;
			Результат.Курсор = Курсор;
			Результат.Загружено = ВсегоЗагружено;
			Возврат Результат;
		КонецЕсли;

		Элементы = Ответ.Данные.items;
		Если Элементы.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;

		// Пачка пишется в одной транзакции; курсор двигается только после успешной записи
		Попытка
			НачатьТранзакцию();
			Для Каждого Элемент Из Элементы Цикл
				ЗаписатьОтветВРегистр(Мероприятие, Элемент);
			КонецЦикла;
			НовыйКурсор = Ответ.Данные.nextAfter;
			ОбновитьРеквизитыМероприятия(Мероприятие, Новый Структура("КурсорВыгрузки, ЗагруженоАнкет",
				НовыйКурсор, Мероприятие.ЗагруженоАнкет + ВсегоЗагружено + Элементы.Количество()));
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ЗаписатьОшибку(Мероприятие, НСтр("ru = 'Ошибка записи ответов в регистр'"), ИнформацияОбОшибке());
			Результат.Сообщение = НСтр("ru = 'Ошибка записи ответов в регистр бигДанныеАнкет. См. журнал регистрации.'");
			Результат.Курсор = Курсор;
			Результат.Загружено = ВсегоЗагружено;
			Возврат Результат;
		КонецПопытки;

		ВсегоЗагружено = ВсегоЗагружено + Элементы.Количество();
		Курсор = НовыйКурсор;

		// Подтверждаем курсор сервису (если ack не дошёл — при следующей загрузке сервис отдаст то же самое, дублей не будет)
		ОтветAck = ВыполнитьЗапрос("POST", "/api/v1/sync/events/" + Идентификатор + "/responses/ack", Новый Структура("seq", Курсор));
		Если НЕ ОтветAck.Успех Тогда
			ЗаписатьОшибку(Мероприятие, НСтр("ru = 'Не удалось подтвердить курсор (ack)'"), ОтветAck.Сообщение);
		КонецЕсли;

		Если Ответ.Данные.hasMore <> Истина Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Результат.Успех     = Истина;
	Результат.Загружено = ВсегоЗагружено;
	Результат.Курсор    = Курсор;
	Результат.Сообщение = ?(ВсегоЗагружено = 0,
		НСтр("ru = 'Новых ответов нет.'"),
		СтрШаблон(НСтр("ru = 'Загружено ответов: %1.'"), ВсегоЗагружено));
	Возврат Результат;

КонецФункции

// Статус мероприятия в сервисе (счётчики, курсор, ссылка).
//
// Параметры:
//   Мероприятие - СправочникСсылка.бигМероприятия
//
// Возвращаемое значение:
//   Структура:
//     * Успех - Булево - запрос выполнен.
//     * Сообщение - Строка - текст ошибки, если Успех = Ложь.
//     * Данные - Структура, Неопределено - ответ сервиса: responses, giftsAwarded, ackedSeq, pending, version, publicUrl.
//
Функция ПолучитьСтатус(Мероприятие) Экспорт

	Ответ = ВыполнитьЗапрос("GET", "/api/v1/sync/events/" + ИдентификаторМероприятия(Мероприятие) + "/status");
	Возврат Новый Структура("Успех, Сообщение, Данные", Ответ.Успех, Ответ.Сообщение, Ответ.Данные);

КонецФункции

// Загрузка результатов по всем опубликованным мероприятиям, окончание которых не раньше 7 дней назад
// (или без даты окончания). Вызывается регламентным заданием бигЗагрузкаРезультатовАнкетирования.
//
Процедура ЗагрузитьРезультатыВсехМероприятий() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Мероприятия.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.бигМероприятия КАК Мероприятия
	|ГДЕ
	|	НЕ Мероприятия.ПометкаУдаления
	|	И НЕ Мероприятия.ЭтоГруппа
	|	И Мероприятия.Опубликовано <> ДАТАВРЕМЯ(1, 1, 1)
	|	И (Мероприятия.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|		ИЛИ Мероприятия.ДатаОкончания >= &Граница)";
	Запрос.УстановитьПараметр("Граница", НачалоДня(ТекущаяДатаСеанса() - 7 * 86400));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат = ЗагрузитьРезультаты(Выборка.Ссылка);
		Если НЕ Результат.Успех Тогда
			// ошибка уже в журнале; продолжаем по остальным мероприятиям
			Продолжить;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Сохраняет настройки подключения к сервису в безопасное хранилище (владелец "survey").
//
// Параметры:
//   URL    - Строка - адрес приложения с контекстом, без завершающего слэша: https://survey.bigcom.ru/survey
//   Логин  - Строка - учётная запись сервиса с ролью INTEGRATION
//   Пароль - Строка
//
Процедура УстановитьНастройкиОбмена(URL, Логин, Пароль) Экспорт

	Настройки = Новый Структура;
	Настройки.Вставить("url", СокрЛП(URL));
	Настройки.Вставить("login", СокрЛП(Логин));
	Настройки.Вставить("password", Пароль);

	УстановитьПривилегированныйРежим(Истина);
	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(ВладелецНастроек(), Настройки, Неопределено);
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Настройки обмена без пароля — для отображения в форме.
//
// Возвращаемое значение:
//   Структура:
//     * URL - Строка - адрес сервиса.
//     * Логин - Строка - учётная запись интеграции.
//     * Заполнены - Булево - заданы адрес, логин и пароль.
//
Функция НастройкиОбмена() Экспорт

	Настройки = ПрочитатьНастройки();
	Возврат Новый Структура("URL, Логин, Заполнены", Настройки.url, Настройки.login,
		ЗначениеЗаполнено(Настройки.url) И ЗначениеЗаполнено(Настройки.login) И ЗначениеЗаполнено(Настройки.password));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВладелецНастроек()
	Возврат "survey";
КонецФункции

Функция ПрочитатьНастройки()

	Настройки = Новый Структура("url, login, password", "", "", "");
	УстановитьПривилегированныйРежим(Истина);
	Сохраненные = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ВладелецНастроек(), "url,login,password");
	УстановитьПривилегированныйРежим(Ложь);
	Если ТипЗнч(Сохраненные) = Тип("Структура") Тогда
		Для Каждого Элемент Из Сохраненные Цикл
			Если ЗначениеЗаполнено(Элемент.Значение) Тогда
				Настройки.Вставить(Элемент.Ключ, Элемент.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Настройки;

КонецФункции

// HTTP-запрос к сервису с Basic-авторизацией. Возвращает Структуру: Успех, КодСостояния, Данные (разобранный JSON), Сообщение.
Функция ВыполнитьЗапрос(Метод, Путь, Тело = Неопределено)

	Результат = Новый Структура("Успех, КодСостояния, Данные, Сообщение", Ложь, 0, Неопределено, "");

	Настройки = ПрочитатьНастройки();
	Если НЕ ЗначениеЗаполнено(Настройки.url) Или НЕ ЗначениеЗаполнено(Настройки.login) Тогда
		Результат.Сообщение = НСтр("ru = 'Не заданы настройки обмена с сервисом анкетирования (бигАнкетированиеОбменСервер.УстановитьНастройкиОбмена).'");
		Возврат Результат;
	КонецЕсли;

	Адрес = Новый Структура("Сервер, Порт, Защищенное, Префикс");
	РазобратьURL(Настройки.url, Адрес);

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Accept", "application/json");
	Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

	Попытка
		Соединение = Новый HTTPСоединение(Адрес.Сервер, Адрес.Порт, Настройки.login, Настройки.password, , 60,
			?(Адрес.Защищенное, Новый ЗащищенноеСоединениеOpenSSL(), Неопределено));
		Запрос = Новый HTTPЗапрос(Адрес.Префикс + Путь, Заголовки);
		Если Тело <> Неопределено Тогда
			ЗаписьJSON = Новый ЗаписьJSON;
			ЗаписьJSON.УстановитьСтроку();
			ЗаписатьJSON(ЗаписьJSON, Тело);
			Запрос.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		КонецЕсли;
		ОтветHTTP = Соединение.ВызватьHTTPМетод(Метод, Запрос);
	Исключение
		Результат.Сообщение = НСтр("ru = 'Сервис анкетирования недоступен: '") + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Результат.КодСостояния = ОтветHTTP.КодСостояния;
	ТелоОтвета = ОтветHTTP.ПолучитьТелоКакСтроку();
	Если ЗначениеЗаполнено(ТелоОтвета) Тогда
		Попытка
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
			Результат.Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
		Исключение
			Результат.Данные = Неопределено;
		КонецПопытки;
	КонецЕсли;

	Если ОтветHTTP.КодСостояния >= 200 И ОтветHTTP.КодСостояния < 300 Тогда
		Результат.Успех = Истина;
		Возврат Результат;
	КонецЕсли;

	Сообщение = "";
	Если ТипЗнч(Результат.Данные) = Тип("Структура") И Результат.Данные.Свойство("message") Тогда
		Сообщение = Строка(Результат.Данные.message);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Сообщение) Тогда
		Сообщение = Лев(ТелоОтвета, 300);
	КонецЕсли;
	Результат.Сообщение = СтрШаблон(НСтр("ru = 'Сервис ответил %1: %2'"), ОтветHTTP.КодСостояния, Сообщение);
	Возврат Результат;

КонецФункции

// https://host[:port]/context → Сервер, Порт, Защищенное, Префикс (/context)
Процедура РазобратьURL(URL, Адрес)

	Строка = СокрЛП(URL);
	Адрес.Защищенное = НРег(Лев(Строка, 8)) = "https://";
	Если Адрес.Защищенное Тогда
		Строка = Сред(Строка, 9);
	ИначеЕсли НРег(Лев(Строка, 7)) = "http://" Тогда
		Строка = Сред(Строка, 8);
	КонецЕсли;
	Позиция = СтрНайти(Строка, "/");
	Если Позиция > 0 Тогда
		ХостПорт = Лев(Строка, Позиция - 1);
		Адрес.Префикс = Сред(Строка, Позиция);
	Иначе
		ХостПорт = Строка;
		Адрес.Префикс = "";
	КонецЕсли;
	Если СтрЗаканчиваетсяНа(Адрес.Префикс, "/") Тогда
		Адрес.Префикс = Лев(Адрес.Префикс, СтрДлина(Адрес.Префикс) - 1);
	КонецЕсли;
	ПозицияПорта = СтрНайти(ХостПорт, ":");
	Если ПозицияПорта > 0 Тогда
		Адрес.Сервер = Лев(ХостПорт, ПозицияПорта - 1);
		Адрес.Порт = Число(Сред(ХостПорт, ПозицияПорта + 1));
	Иначе
		Адрес.Сервер = ХостПорт;
		Адрес.Порт = ?(Адрес.Защищенное, 443, 80);
	КонецЕсли;

КонецПроцедуры

Функция ИдентификаторМероприятия(Мероприятие)
	Возврат НРег(Строка(Мероприятие.УникальныйИдентификатор()));
КонецФункции

Функция ДатаВСтрокуISO(Дата)
	Если НЕ ЗначениеЗаполнено(Дата) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Формат(Дата, "ДФ=yyyy-MM-dd");
КонецФункции

// "2026-10-21T11:42:07.123456Z" → Дата (в часовом поясе сеанса)
Функция ДатаИзСтрокиISO(Строка)
	Если НЕ ЗначениеЗаполнено(Строка) Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Текст = Строка(Строка);
	// Убираем дробные секунды и признак Z/смещение — берём момент как UTC и переводим в локальное время сеанса
	Позиция = СтрНайти(Текст, ".");
	Если Позиция > 0 Тогда
		Хвост = Сред(Текст, Позиция);
		Конец = 1;
		Пока Конец <= СтрДлина(Хвост) И (СтрНайти("0123456789.", Сред(Хвост, Конец, 1)) > 0) Цикл
			Конец = Конец + 1;
		КонецЦикла;
		Текст = Лев(Текст, Позиция - 1) + Сред(Хвост, Конец);
	КонецЕсли;
	Смещение = 0;
	Если СтрЗаканчиваетсяНа(Текст, "Z") Тогда
		Текст = Лев(Текст, СтрДлина(Текст) - 1);
	ИначеЕсли СтрДлина(Текст) >= 25 И (Сред(Текст, 20, 1) = "+" Или Сред(Текст, 20, 1) = "-") Тогда
		Знак = ?(Сред(Текст, 20, 1) = "-", -1, 1);
		Смещение = Знак * (Число(Сред(Текст, 21, 2)) * 3600 + Число(Сред(Текст, 24, 2)) * 60);
		Текст = Лев(Текст, 19);
	КонецЕсли;
	Попытка
		МоментUTC = ПрочитатьДатуJSON(Текст, ФорматДатыJSON.ISO) - Смещение;
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;
	Возврат МестноеВремя(МоментUTC, ЧасовойПоясСеанса());
КонецФункции

// Запись/обновление строки РС бигДанныеАнкет по ответу сервиса.
// Ключ строки: Дата = submittedAt, Мероприятие, Идентификатор = id ответа. Повторный приход того же id обновляет БонусПредоставлен.
Процедура ЗаписатьОтветВРегистр(Мероприятие, Элемент)

	Идентификатор = Лев(Строка(Элемент.id), 36);
	ДатаОтвета = ДатаИзСтрокиISO(Элемент.submittedAt);
	Если НЕ ЗначениеЗаполнено(ДатаОтвета) Тогда
		ДатаОтвета = ТекущаяДатаСеанса();
	КонецЕсли;

	// Ответы как в v1: Структура «поле → значение» (сервис уже отдаёт строки; массивы через запятую)
	Ответы = Новый Структура;
	Если ТипЗнч(Элемент.answers) = Тип("Соответствие") Тогда
		Для Каждого Пара Из Элемент.answers Цикл
			Ответы.Вставить(ИмяСвойстваСтруктуры(Пара.Ключ), ЗначениеДляРегистра(Пара.Значение));
		КонецЦикла;
	ИначеЕсли ТипЗнч(Элемент.answers) = Тип("Структура") Тогда
		Для Каждого Пара Из Элемент.answers Цикл
			Ответы.Вставить(Пара.Ключ, ЗначениеДляРегистра(Пара.Значение));
		КонецЦикла;
	КонецЕсли;
	Если НЕ Ответы.Свойство("Телефон") И Элемент.Свойство("phone") Тогда
		Ответы.Вставить("Телефон", Строка(Элемент.phone));
	КонецЕсли;

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Элемент);
	ДанныеJSON = ЗаписьJSON.Закрыть();

	Бонус = Ложь;
	Если Элемент.Свойство("gift") И ТипЗнч(Элемент.gift) = Тип("Структура") И Элемент.gift.Свойство("awarded") Тогда
		Бонус = Элемент.gift.awarded = Истина;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	Набор = РегистрыСведений.бигДанныеАнкет.СоздатьНаборЗаписей();
	Набор.Отбор.Дата.Установить(ДатаОтвета);
	Набор.Отбор.Мероприятие.Установить(Мероприятие);
	Набор.Отбор.Идентификатор.Установить(Идентификатор);
	Набор.Прочитать();
	Если Набор.Количество() = 0 Тогда
		Запись = Набор.Добавить();
	Иначе
		Запись = Набор.Получить(0);
	КонецЕсли;
	Запись.Дата             = ДатаОтвета;
	Запись.Мероприятие      = Мероприятие;
	Запись.Идентификатор    = Идентификатор;
	Запись.Данные           = Новый ХранилищеЗначения(Ответы);
	Запись.ДанныеJSON       = Новый ХранилищеЗначения(ДанныеJSON);
	Запись.БонусПредоставлен = Бонус;
	Набор.Записать(Истина);
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Имена полей анкеты задаёт настройщик в 1С — они допустимы как ключи Структуры (как в v1). На случай пробелов/дефисов — заменяем.
Функция ИмяСвойстваСтруктуры(Ключ)
	Имя = СтрЗаменить(СтрЗаменить(СокрЛП(Ключ), " ", "_"), "-", "_");
	Если ЗначениеЗаполнено(Имя) И СтрНайти("0123456789", Лев(Имя, 1)) > 0 Тогда
		Имя = "_" + Имя;
	КонецЕсли;
	Возврат Имя;
КонецФункции

Функция ЗначениеДляРегистра(Значение)
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Части = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Части.Добавить(Строка(Элемент));
		КонецЦикла;
		Возврат СтрСоединить(Части, ", ");
	ИначеЕсли Значение = Неопределено Или Значение = Null Тогда
		Возврат "";
	КонецЕсли;
	Возврат Значение;
КонецФункции

Процедура ОбновитьРеквизитыМероприятия(Мероприятие, Значения)

	УстановитьПривилегированныйРежим(Истина);
	Объект = Мероприятие.ПолучитьОбъект();
	Объект.Заблокировать();
	ЗаполнитьЗначенияСвойств(Объект, Значения);
	Объект.ДополнительныеСвойства.Вставить("бигОбменАнкетирования", Истина);
	Объект.ОбменДанными.Загрузка = Истина; // техническое обновление служебных реквизитов без бизнес-проверок
	Объект.Записать();
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

Процедура ЗаписатьОшибку(Мероприятие, Заголовок, Подробности)

	Текст = Заголовок + ": ";
	Если ТипЗнч(Подробности) = Тип("ИнформацияОбОшибке") Тогда
		Текст = Текст + ОбработкаОшибок.ПодробноеПредставлениеОшибки(Подробности);
	Иначе
		Текст = Текст + Строка(Подробности);
	КонецЕсли;
	ЗаписьЖурналаРегистрации("Анкетирование.ОбменССервисом", УровеньЖурналаРегистрации.Ошибка,
		Метаданные.Справочники.бигМероприятия, Мероприятие, Текст);

КонецПроцедуры

#КонецОбласти
