+# Лимит заказа звонка на КРАЕВОМ nginx, когда схема такая: интернет → nginx → IIS → Tomcat.
+# Только здесь виден настоящий адрес посетителя ($binary_remote_addr), поэтому лимит ставим именно на этом узле.
+# IIS и Tomcat после nginx видят адрес nginx, считать лимит по ним нельзя.
+#
+# 1) zone — в http{} (например, в /etc/nginx/conf.d/survey-ratelimit.conf, вне server{}):
+limit_req_zone $binary_remote_addr zone=survey_pub:10m  rate=10r/s;   # публичный API анкеты
+# Заказ звонка стоит денег: отдельный, более строгий предел. Посетители за одним адресом (общий Wi-Fi площадки,
+# мобильный NAT) делят его: подберите rate/burst под ожидаемое число людей на площадке одновременно.
+limit_req_zone $binary_remote_addr zone=survey_call:10m rate=30r/m;
+
+# 2) locations — в server{} вашего домена (1cbig.bigcom.ru), ПЕРЕД общим location, который проксирует /survey/ на IIS.
+#    proxy_pass и proxy_set_header скопируйте из вашего существующего location для /survey/ (здесь UPSTREAM_IIS —
+#    то, что у вас там указано). Заголовки Host и X-Forwarded-* должны остаться теми же.
+#
+#    location ^~ /survey/api/v1/public/ {
+#        limit_req zone=survey_pub burst=30 nodelay;
+#        limit_req_status 429;
+#        proxy_pass UPSTREAM_IIS;
+#        # ... те же proxy_set_header / proxy_http_version / proxy_read_timeout, что в location для /survey/ ...
+#
+#        # Заказ flash-call: действуют оба предела; заголовки наследуются от внешнего location
+#        location ~ ^/survey/api/v1/public/events/[^/]+/phone/call$ {
+#            limit_req zone=survey_pub burst=30 nodelay;
+#            limit_req zone=survey_call burst=20 nodelay;
+#            proxy_pass UPSTREAM_IIS;
+#        }
+#    }
+#
+#    Если proxy_pass у вас с URI (например, http://iis/survey/), в вложенном location он должен быть записан так же.
