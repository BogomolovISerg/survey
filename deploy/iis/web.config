<?xml version="1.0" encoding="UTF-8"?>
<!--
  Реверс-прокси survey на IIS (erp-web) через ARR: сайт с биндингом survey.bigcom.ru:443
  проксирует ВСЁ на внутренний сервер приложений 10.0.0.4 (nginx -> Tomcat /survey).
  Файл кладётся в корневой каталог этого сайта (например C:\inetpub\survey-proxy\web.config).

  Предварительно (один раз на сервере):
   1) Установить Application Request Routing 3.0 и URL Rewrite (если нет).
   2) IIS Manager -> узел сервера -> Application Request Routing Cache -> Server Proxy Settings ->
      Enable proxy = ON; Reverse rewrite host in response headers = OFF.
   3) IIS Manager -> узел сервера -> URL Rewrite -> View Server Variables -> Add:
      HTTP_X_FORWARDED_PROTO, HTTP_X_FORWARDED_HOST  (разрешить их установку правилами).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Снаружи интеграция с 1С и actuator недоступны: из внутренней сети 1С ходит на 10.0.0.4 напрямую -->
        <rule name="block sync from internet" stopProcessing="true">
          <match url="^survey/(api/v1/sync/|actuator/)" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>

        <!-- Корень -> приложение -->
        <rule name="root redirect" stopProcessing="true">
          <match url="^$" />
          <action type="Redirect" url="/survey/" redirectType="Found" />
        </rule>

        <!-- Всё остальное — проксирование на внутренний nginx (путь сохраняется: /survey/...) -->
        <rule name="survey reverse proxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://10.0.0.4/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="4194304" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
